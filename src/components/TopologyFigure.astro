    </text>
    <rect x="157" y="66" width="206" height="66" rx="2" />
    <text x="178" y="94">
      Phoenix
    </text>
    <text class="caption" x="178" y="115">
      PUBLIC INGRESS · x86
    </text>
    <path d="M105 173H415" stroke-dasharray="4 6" />
    <text class="caption" x="260" y="160" text-anchor="middle">
      COMPUTE ROLES / LOGICAL GROUPING
    </text>
    <rect x="18" y="198" width="224" height="67" rx="2" />
    <text x="38" y="225">
      Monster
    </text>
    <text class="caption" x="38" y="248">
      CORE + OBSERVABILITY · ARM64
    </text>
    <rect x="278" y="198" width="224" height="67" rx="2" />
    <text x="298" y="225">
      Wraith
    </text>
    <text class="caption" x="298" y="248">
      ASYNC WORKLOADS · x86
    </text>
