---
import HeroSystem from '../HeroSystem.astro';
---

<section class="studio-hero" aria-labelledby="intro">
  <div class="studio-kicker">CLOUD INFRASTRUCTURE / LINUX / TECHNICAL SUPPORT</div>
  <div class="hero-stage">
    <div>
      <h1 id="intro">
        <span class="line hero-line-1">Good systems.</span>
        <span class="line hero-line-2">Clear</span>
        <span class="line hero-line-3 blue">boundaries.</span>
      </h1>
      <p class="hero-intro">
        I’m Pratik. I build, secure and troubleshoot infrastructure — bringing hands-on cloud
        projects together with a background in international customer support.
      </p>
      <div class="studio-actions">
        <a class="studio-action primary" href="#work">
          Explore the work <span aria-hidden="true">↘</span>
        </a>
        <a class="studio-action" href="/resume/Pratik-Deshmukh.pdf" download>
          Résumé (PDF) <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <HeroSystem />
  </div>
  <div class="hero-foot">
    <div class="discipline">
      <span>01 / Cloud & Linux</span>
      <span>02 / Networking & security</span>
      <span>03 / Identity & support</span>
    </div>
    <a href="#work">
      A closer look <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
