---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { createHash } from 'node:crypto';
import '../styles/base.css';
import '../styles/studio.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  canonicalPath?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  bodyClass = '',
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath, 'https://pratikdeshmukh.co.in').href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pratik S. Deshmukh',
  url: 'https://pratikdeshmukh.co.in/',
  email: 'mailto:pratik.s.deshmukh@outlook.com',
  knowsAbout: ['Linux', 'Cloud infrastructure', 'Networking', 'Microsoft 365', 'Technical support'],
};
const personJson = JSON.stringify(person);
const structuredDataHash = createHash('sha256').update(personJson).digest('base64');
const contentPolicy = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${structuredDataHash}'`,
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={contentPolicy} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0e" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/IBMPlexSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pratik S. Deshmukh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://pratikdeshmukh.co.in/images/social-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Pratik Deshmukh — Cloud, Linux and technical support. Good systems. Clear boundaries."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={personJson} />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
